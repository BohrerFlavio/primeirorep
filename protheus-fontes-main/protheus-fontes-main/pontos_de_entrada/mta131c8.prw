User Function MTA131C8()

	Local oModFor := PARAMIXB[1]
	
	//Customizações do usuario
	reclock('SC8',.f.)
	
	oModFor:LoadValue("C8_DESCRI2",SC1->C1_DESCRI)
	oModFor:LoadValue("C8_MAILUSR",AllTrim(UsrRetMail(RetCodUsr())))
	oModFor:LoadValue("C8_VALIDA",DataValida(dDataBase + 5))
	oModFor:LoadValue("C8_GRUPO",SC1->C1_GRUPO)
	
	msunlock()
	
Return(.T.)

