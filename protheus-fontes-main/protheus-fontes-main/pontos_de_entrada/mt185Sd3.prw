User Function MT185SD3()                        

	M->D3_SOLARM := SCP->CP_NUM  
	M->D3_CC     := SCP->CP_CC
	if SCP->(CP_GRUPO = '1301' .and. CP_LOCAL = '04')
		M->D3_TM = '502'
	endif
	M->D3_LOCALIZ := GetAdvFVal("SBF", "BF_LOCALIZ", FWxfilial("SBF") + padr(M->D3_COD,15,' ') + M->D3_LOCAL, 2)

Return 
