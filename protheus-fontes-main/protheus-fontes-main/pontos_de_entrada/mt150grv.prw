User Function MT150GRV()

	reclock('SC8',.f.)
	SC8->C8_DESCRI2 := fbuscaCPO('SC1',1,xfilial('SC1')+SC8->C8_NUMSC+SC8->C8_ITEMSC,'C1_DESCRI')
	msunlock()

Return(.T.)
