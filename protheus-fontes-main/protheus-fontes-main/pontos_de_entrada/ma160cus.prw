User Function  MA160CUS()

	Local cAliasSC8 := PARAMIXB[1]   //Alias da tabela SC8
	Local nItem     := PARAMIXB[2]   //Item a ser calculado    

	nNewCustoEntrada := RetCustUSR(cAliasSC8,nItem)   

Return( nNewCustoEntrada) 

//Fun็ใo para ralizar calculo do novo custo
Static Function RetCustUSR(cAliasSC8,nItem)   
	Local _custo     := 0.00                      //Custo final

	DbSelectArea(cAliasSC8)
	_custo := C8_TOTAL + C8_DIFALIQ + C8_VALSOL + 	C8_VALIPI + C8_TOTFRE - C8_VLDESC

return _custo
