User Function DTI203()
    //Variaveis para dimensões dos forms
    Private _cGrpProc  := alltrim(GetMV('MV_GRPPORC'))
    Private _cGrpMds   := alltrim(GetMV('MV_GRPMDS'))
    Private _cGrpCrq   := alltrim(GetMV('MV_GRPCHRQ'))
    Private tsTop      := 0
    Private tsLeft     := 0
    Private tsBottom   := 400
    Private tsRight    := 300
    Private tsCaption  := 'Impressão de etiquetas identificadoras de produtos.'
    Private tsClrText  := CLR_BLACK
    Private tsClrBack  := CLR_WHITE
    Private tsPixel    := .T.
    //Variaveis gerais
    Private _cCmdZPL   := ""
    Private xTGet1     := Space(6) //codigo do produto
    Private xTGet2     := SToD("") //Data de abate
    Private xTGet3     := SToD("") //Data de produção
    Private xTGet4     := Space(6) //Quantidade de etiquetas
    Private xTGet5     := Space(1) //codigo da mesa
    Private _cDescProd := Space(40)    
    Private _nTaraProd := 0.000
    Private _cQtdEtq   := Space(6)
    Private _nQtdEtq   := 0

    oDialog := TDialog():New(tsTop, tsLeft, tsBottom, tsRight, tsCaption, , , , , tsClrText, tsClrBack, , , tsPixel)
        oFont:= TFont():New('Arial',, -12, .T.)

        oSay1:= TSay():New(010,15,{||'Código do produto:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay2:= TSay():New(025,15,{||'Descrição do produto:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay3:= TSay():New(040,15,{||'Data de abate:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay4:= TSay():New(055,15,{||'Data de produção:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay5:= TSay():New(070,15,{||'Tara:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay6:= TSay():New(085,15,{||'Quant. de Caxias:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay7:= TSay():New(100,15,{||'Quant. de Etiquetas:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay11:= TSay():New(115,15,{||'Seq. Lote:'},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)

        oSay8:= TSay():New(025,080,{||_cDescProd},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay9:= TSay():New(070,080,{||STR(_nTaraProd) + "g"},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)
        oSay10 :=TSay():New(100,080,{||_cQtdEtq},oDialog,,oFont,,,,.T.,CLR_BLACK,CLR_WHITE,200,20)

        oTGet1 := TGet():New(10,75,{ | u | If( PCount() > 0, xTGet1 := u, xTGet1) },oDialog,40,10, "@!",,0,,,.F.,,.T.,,.F.,,.F.,.F.,,.F.,.F.,,xTGet1,,,,.t., )
            oTGet1:cF3 := 'ZZ7'
            //oTGet1:bValid := {|| Validacoes() }
            oTGet1:bValid := {|| PorChar() }
            oTGet1:Picture := '@!'
        oTGet2 := TGet():New(040,75,{ | u | If( PCount() > 0, xTGet2 := u, xTGet2) },oDialog,40,10,,,0,,,.F.,,.T.,,.F.,,.F.,.F.,,.F.,.F.,,,,,,.t., )            
        oTGet3 := TGet():New(055,75,{ | u | If( PCount() > 0, xTGet3 := u, xTGet3) },oDialog,40,10,,,0,,,.F.,,.T.,,.F.,,.F.,.F.,,.F.,.F.,,,,,,.t., )
        oTGet4 := TGet():New(085,75,{ | u | If( PCount() > 0, xTGet4 := u, xTGet4) },oDialog,40,10, "@!",,0,,,.F.,,.T.,,.F.,,.F.,.F.,,.F.,.F.,,xTGet4,,,,.t., )
            oTGet4:bValid := {|| QuantEtq() }
            oTGet4:Picture := '@!'
        oTGet5 := TGet():New(115,75,{ | u | If( PCount() > 0, xTGet5 := u, xTGet5) },oDialog,40,10, "@!",,0,,,.F.,,.T.,,.F.,,.F.,.F.,,.F.,.F.,,xTGet5,,,,.t., )            

        oTButton1 := TButton():New(140, 50, "Imprimir",oDialog,{||Validacoes()}, 40,10,,,.F.,.T.,.F.,,.F.,,,.F. )
        oTButton2 := TButton():New(155, 50, "Cancelar e Sair",oDialog,{||oDialog:end()}, 40,10,,,.F.,.T.,.F.,,.F.,,,.F. )

        oTGet1:bLostFocus:= {|| Dados()}
    oDialog:Activate(,,,.T.,,,)
Return

Static Function PorChar()
    _cCodGrpProd := GetAdvFval('SB1','B1_GRUPO',FWxFilial('SB1')+alltrim(xTGet1),1) //BUSCA GRUPO DE PRODUTOS

    If ALLTRIM(_cCodGrpProd) $ (_cGrpProc + _cGrpCrq)
		oTGet2:disable()
		oTGet2:hide()
        oSay3:disable()
        oSay3:hide()
        oTGet5:disable()
		oTGet5:hide()
        oSay11:disable()
        oSay11:hide()

		Return .T.
	Else
		oTGet2:enable()
		oTGet2:show()
		oTGet2:setFocus()
        oSay3:enable()
        oSay3:show()
        oTGet5:enable()
		oTGet5:show()        
        oSay11:enable()
        oSay11:show()

		Return .T.
	Endif
Return

Static Function Validacoes()
    _cCodGrpProd := GetAdvFval('SB1','B1_GRUPO',FWxFilial('SB1')+alltrim(xTGet1),1)

    //VALIDAÇÃO PARA GARANTIR QUE UM PRODUTO FOI INSERIDO
    If (empty(oTGet1:bLostFocus))
        MsgAlert("Obrigatrório informar um produto.", "Aviso")
    Endif

    ZZ7->(DbSetOrder(1))
    If !ZZ7->(MsSeek(FWxFilial('ZZ7')+xTGet1))
        MsgAlert("Produto informado não existe.", "Aviso")
        Return
    Endif

    //VALIDAÇÃO PARA GARANTIR QUE UMA DATA DE ABATE FOI INFORMADA
    //SOMENTE PARA PRODUTOS DO PORCIONADOS NÃO SERÁ OBRIGADO INFORMAR DATA DE ABATE
    If !(_cCodGrpProd $ _cGrpProc)
        If (empty(xTGet2))
            MsgAlert("Obrigatrório informar uma data de abate.", "Aviso")
            Return
        Endif
    Endif

    //VALIDAÇÃO PARA GARANTIR QUE UMA DATA DE PRODUÇÃO FOI INFORMADA
    If (empty(xTGet3))
        MsgAlert("Obrigatrório informar uma data de produção.", "Aviso")
        Return
    Endif

    //VALIDAÇÃO PARA SABER SE NA DATA INFORMADA HOUVE ABATE. SOMENTE PARA PRODUTOS DO PORCIONADOS NÃO SERÁ OBRIGADO INFORMAR DATA DE ABATE
    If !(_cCodGrpProd $ _cGrpProc)
        If Empty(GetAdvFval('SZG','ZG_DATA',FWxFilial('SZG')+DToS(xTGet2),2)) .AND. Empty(GetAdvFval('ZAP','ZAP_DATAP',FWxFilial('ZAP') + DToS(xTGet2),4))
            MsgAlert("Na data informada não houve abate!","Alerta")
            Return
        Endif
    Endif

    //VALIDAÇÃO PARA GARANTIR QUE A DATA DE ABATE INSERIDA NÃO SEJA A DATA BASE OU SUPERIOR, COM EXCESSÃO DE PRODUTOS DO MIÚDOS
    If !(_cCodGrpProd $ _cGrpMds)
        If (xTGet2 = DDATABASE)
            MsgAlert("Data de abate não pode ser igual a data do dia.", "Aviso")
            Return
        Endif
    Endif

    //VALIDAÇÃO PARA GARANTIR QUE NÃO SEJA DEFINIDA UMA DATA FUTURA COMO DATA DE ABATE
    If (xTGet2 > Date())
        MsgAlert("Data de abate não pode ser maior que a data do dia.", "Aviso")
        Return
    Endif

    //VALIDAÇÃO PARA GARANTIR QUE A QUANTIDADE DE ETIQUETAS A SEREM IMPRESSA SEJA INSERIDA
    If (empty(xTGet4))
        MsgAlert("Obrigatrório informar quantidade de etiquetas.", "Aviso")
        Return        
    Endif
    Imprime()
Return

Static Function Dados()
    _cDescProd := GetAdvFval('ZZ7','ZZ7_CORTE',FWxFilial('ZZ7') + alltrim(xTGet1),1)
    taraSB1    := GetAdvFval('SB1','B1_CTARAP',FWxfilial('SB1')+alltrim(xTGet1),1) // Linhas inseridas para buscar"_NTARAp"
	taraZAB    := GetAdvFval('ZAB','ZAB_TARA',FWxfilial('ZAB')+alltrim(taraSB1),1) // os campos de codigo das taras primarias
	_nTaraProd := (taraZAB * 1000)
	oDialog:refresh()
Return

Static Function QuantEtq()
    a := GetAdvFval('SB1','B1_QCAIX',FWxFilial('SB1') + alltrim(xTGet1),1)
    _cQtdEtq := ALLTRIM(STR(a * VAL(xTGet4)))
    _nQtdEtq := (a * VAL(xTGet4))
    oDialog:refresh()
Return

Static Function CalcPesoMed(caixas,Codigo)
	If !empty(caixas) .and. !empty(Codigo)
		pmc    := GetAdvFval('SB1','B1_PMCAIX',FWxfilial('SB1')+Codigo,1)
		pmedio := (caixas * pmc)
		Return pmedio
	Endif
Return 0

Static Function Imprime()
	Processa({||ETIQUETA() },"IMPRESSAO DE ETIQUETA","Realizando envio à impressora...")
Return

Static Function ETIQUETA()
    ProcRegua(VAL(xTGet4))

    incproc()

    _cEst := getComputerName()
	_cIp  := ''

	ZAM->(dbSetOrder(2))
	If ZAM->(MsSeek(xFilial('ZAM') + alltrim(_cEst)))
		_cIp := alltrim(ZAM->ZAM_IP)
	Endif

	If empty(_cIp)
		MSCBPRINTER('S600','LPT1')
	Else
		MSCBPRINTER('S600','IP',,,,,_cIp) //Impressão por IP
	Endif

    MSCBCHKSTATUS(.F.)
    MSCBBEGIN(_nQtdEtq,6,15)

    EtiquetasInternaRecortes()

    MSCBEND()
	MSCBCLOSEPRINTER()

    LimpaCampos()

	oTButton1:enable()
	oDialog:refresh()
Return

Static Function LimpaCampos()
    xTGet1     := Space(6)
    xTGet2     := SToD("")
    xTGet3     := SToD("")
    xTGet4     := Space(6)
    _cDescProd := Space(40)
    _nTaraProd := 0.000
    _cQtdEtq   := Space(6)

	oDialog:refresh()
Return

Static Function EtiquetasInternaRecortes()

    SB1->(DbSetOrder(1))
    SB1->(MsSeek(FWxFilial('SB1')+alltrim(xTGet1)))

    Local _DtaAbt := AllTrim(DToC(xTGet2))
    Local _DtAbtI  := SUBSTR(_DtaAbt,4,3) + SUBSTR(_DtaAbt,1,3) + SUBSTR(_DtaAbt,7,2)
    Local _DtaPro  := AllTrim(DToC(xTGet3))
    Local _DtaProI := SUBSTR(DToC(xTGet3),4,3)+ SUBSTR(DToC(xTGet3),1,3)+SUBSTR(DToC(xTGet3),7,2)
    Local _DtVal   := DToC(xTGet3 + SB1->B1_VALID)
    Local _DtValI  := SUBSTR(_DtVal,4,3) + SUBSTR(_DtVal,1,3) + SUBSTR(_DtVal,7,2)
    Local _DtaProx := StrTran(Alltrim(_DtaPro), "/", "")
    Local _MsgTem  := AllTrim(SB1->B1_MENETQ2)
    Local _CadMerc := SB1->B1_CADMERC
    Local _Program := alltrim(SB1->B1_PROGRAM)

	MSCBWrite("^XA")
	MSCBWrite("^CWA,E:ARIAL.TTF")
    MSCBWrite("^FWR")

    ZZ7->(DbSetOrder(1))
    ZZ7->(MsSeek(FWxFilial('ZZ7')+xTGet1))

    If _CadMerc = "C" .and. "006" $ _Program // Etiqueta grande para Canadá (Tamanho pão de açúcar) e Angus

        MSCBWrite("^CFA,26")
        MSCBWrite("^FO" + "750,052" + "^FH\^FD" + ZZ7->ZZ7_DESC + "^FS")
        MSCBWrite("^FO" + "710,052" + "^FH\^FD" + ZZ7->ZZ7_DESCI + "^FS")
        MSCBWrite("^FO" + "670,052" + "^FH\^FD" + ZZ7->ZZ7_CORTE + "^FS")
        MSCBWrite("^FO" + "630,052" + "^FH\^FD" + ZZ7->ZZ7_CORTEI + "^FS")

        MSCBWrite("^FO" + "590,052" + "^FH\^FD" + "DATA DE ABATE: ^FS")
        MSCBWrite("^FO" + "550,052" + "^FH\^FD" + "SLAUGHTER DATE: ^FS")
        MSCBWrite("^FO" + "510,052" + "^FH\^FD" + "DATA DE PRODU\80\C7O: ^FS")
        MSCBWrite("^FO" + "470,052" + "^FH\^FD" + "PRODUCTION DATE: ^FS")
        MSCBWrite("^FO" + "430,052" + "^FH\^FD" + "DATA DE VALIDADE: ^FS")
        MSCBWrite("^FO" + "390,052" + "^FH\^FD" + "EXPIRY DATE: ^FS")

        MSCBWrite("^FO" + "590,400" + "^FH\^FD" + _DtaAbt + "^FS")
        MSCBWrite("^FO" + "550,400" + "^FH\^FD" + _DtAbtI + "^FS")
        MSCBWrite("^FO" + "510,400" + "^FH\^FD" + _DtaPro + "^FS")
        MSCBWrite("^FO" + "470,400" + "^FH\^FD" + _DtaProI + "^FS")
        MSCBWrite("^FO" + "430,400" + "^FH\^FD" + _DtVal + "^FS")
        MSCBWrite("^FO" + "390,400" + "^FH\^FD" + _DtValI + "^FS")
        MSCBWrite("^CFA,32^FO" + "340,052" + "^FH\^FD" + "LOTE/LOT: " + "D"+ _DtaProx + "P" + xTGet1 + "0" + xTGet5 + "^FS")
        MSCBWrite("^CFA,190^FO" + "340,830" + "^FH\^FD" + "0" + xTGet5 + "^FS")
        MSCBWrite("^CFA,26")
        MSCBWrite("^FO" + "300,052" + "^FH\^FD" + "N\C7O CONT\90M GL\E9TEN/GLUTEN FREE" + "^FS")
        If ("CELSIUS" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELSIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Elseif ("CELCIUS" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELCIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Elseif ("CELSI" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELCIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Endif    
        MSCBWrite("^FO" + "260,052" + "^FH\^FD" + SUBSTR(_MsgTem,1,29) + "^FS")
        MSCBWrite("^FO" + "220,052" + "^FH\^FD" + "KEEP FROZEN AT -18 \A7C" + "^FS")

        //CODIGO DE BARRA
        MSCBWrite("^BY4,3,75")
        MSCBWrite("^FT230,850")
        MSCBWrite("^BCR,,Y,N")
        MSCBWrite("^FD>;" + ZZ7->ZZ7_CODPRO + "^FS")
        //IMAGEM LOGO SIF
        MSCBWrite("^FO" + "300,1050")
        MSCBWrite("^IME:LOGOSIF.GRF,1,1^FS")
        //QR CODE
        MSCBWrite("^FO" + "130,1300")
        MSCBWrite("^BQN,2,6")
        MSCBWrite("^FDMA," + "https://cnabrasil.org.br/protocolo-angus" + "^FS")
        //IMAGEM LOGO CERTIFICAÇÃO
        MSCBWrite("^FO" + "300,600")
        MSCBWrite(AngLogoImg())
        MSCBWrite("^FO" + "450,010^FH\^FD ^FS")
        //INFORMAÇÕES NO RODAPÉ DA ETIQUETA
        MSCBWrite("^CFA,20")
        MSCBWrite("^FO" + "185,052")
        MSCBWrite("^FH\^FD" + "Registro no Minist\82rio da Agricultura SIF/DIPOA sob n.\A7 " + AllTrim(ZZ7->ZZ7_MSIF) + "^FS")
        MSCBWrite("^FO" + "160,052")
        MSCBWrite("^FH\^FD" + "Registration with the Ministry of Agriculture SIF/DIPOA no. " + AllTrim(ZZ7->ZZ7_MSIF) + "^FS")
        MSCBWrite("^FO" + "135,052")
        MSCBWrite("^FH\^FD" + "Produzida de acordo com o protocolo Angus, contendo no m\A1nimo 50\25 de sangue Angus e suas cruzas" + "^FS")
        MSCBWrite("^FO" + "110,052")
        MSCBWrite("^FH\^FD" + "Produced according to the Angus protocol, containing at least 50\25 Angus blood and their crosses" + "^FS")
        MSCBWrite("^FO" + "085,052")
        MSCBWrite("^FH\^FD" + "Frigor\A1fico Silva Ind\A3stria e Com\82rcio LTDA." + "^FS")
        MSCBWrite("^FO" + "060,052")
        MSCBWrite("^FH\^FD" + "Abatedouro Frigor\A1fico Ind. e Com. de Carnes e seus derivados, BR 392 km 8 Tomazetti, Santa Maria - RS - Brasil, CEP 97065-400, CNPJ: 88.728.027/0001-46" + "^FS")
        MSCBWrite("^FO" + "035,052")
        MSCBWrite("^FH\^FD" + "Ind\A3stria Brasileira / Product of Brazil" + "^FS")

        MSCBWrite("^PQ" + _cQtdEtq + ",0,1,N")
        MSCBWrite("^XZ")

    Elseif _CadMerc = "C" .and. !("006" $ _Program) // Etiqueta grande para Canadá (Tamanho pão de açúcar) e não Angus

        MSCBWrite("^CFA,26")
        MSCBWrite("^FO" + "750,052" + "^FH\^FD" + ZZ7->ZZ7_DESC + "^FS")
        MSCBWrite("^FO" + "710,052" + "^FH\^FD" + ZZ7->ZZ7_DESCI + "^FS")
        MSCBWrite("^FO" + "670,052" + "^FH\^FD" + ZZ7->ZZ7_CORTE + "^FS")
        MSCBWrite("^FO" + "630,052" + "^FH\^FD" + ZZ7->ZZ7_CORTEI + "^FS")

        MSCBWrite("^FO" + "590,052" + "^FH\^FD" + "DATA DE ABATE: ^FS")
        MSCBWrite("^FO" + "550,052" + "^FH\^FD" + "SLAUGHTER DATE: ^FS")
        MSCBWrite("^FO" + "510,052" + "^FH\^FD" + "DATA DE PRODU\80\C7O: ^FS")
        MSCBWrite("^FO" + "470,052" + "^FH\^FD" + "PRODUCTION DATE: ^FS")
        MSCBWrite("^FO" + "430,052" + "^FH\^FD" + "DATA DE VALIDADE: ^FS")
        MSCBWrite("^FO" + "390,052" + "^FH\^FD" + "EXPIRY DATE: ^FS")

        MSCBWrite("^FO" + "590,400" + "^FH\^FD" + _DtaAbt + "^FS")
        MSCBWrite("^FO" + "550,400" + "^FH\^FD" + _DtAbtI + "^FS")
        MSCBWrite("^FO" + "510,400" + "^FH\^FD" + _DtaPro + "^FS")
        MSCBWrite("^FO" + "470,400" + "^FH\^FD" + _DtaProI + "^FS")
        MSCBWrite("^FO" + "430,400" + "^FH\^FD" + _DtVal + "^FS")
        MSCBWrite("^FO" + "390,400" + "^FH\^FD" + _DtValI + "^FS")
        MSCBWrite("^CFA,32^FO" + "340,052" + "^FH\^FD" + "LOTE/LOT: " + "D"+ _DtaProx + "P" + xTGet1 + "0" + xTGet5 + "^FS")
        MSCBWrite("^CFA,190^FO" + "340,830" + "^FH\^FD" + "0" + xTGet5 + "^FS")
        MSCBWrite("^CFA,26")
        MSCBWrite("^FO" + "300,052" + "^FH\^FD" + "N\C7O CONT\90M GL\E9TEN/GLUTEN FREE" + "^FS")
        If ("CELSIUS" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELSIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Elseif ("CELCIUS" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELCIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Elseif ("CELSI" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELCIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Endif    
        MSCBWrite("^FO" + "260,052" + "^FH\^FD" + SUBSTR(_MsgTem,1,29) + "^FS")
        MSCBWrite("^FO" + "220,052" + "^FH\^FD" + "KEEP FROZEN AT -18 \A7C" + "^FS")

        //CODIGO DE BARRA
        MSCBWrite("^BY4,3,75")
        MSCBWrite("^FT230,850")
        MSCBWrite("^BCR,,Y,N")
        MSCBWrite("^FD>;" + ZZ7->ZZ7_CODPRO + "^FS")
        //IMAGEM LOGO SIF
        MSCBWrite("^FO" + "300,1050")
        MSCBWrite("^IME:LOGOSIF.GRF,1,1^FS")
        //INFORMAÇÕES NO RODAPÉ DA ETIQUETA
        MSCBWrite("^CFA,20")
        MSCBWrite("^FO" + "185,052")
        MSCBWrite("^FH\^FD" + "Registro no Minist\82rio da Agricultura SIF/DIPOA sob n.\A7 " + AllTrim(ZZ7->ZZ7_MSIF) + "^FS")
        MSCBWrite("^FO" + "160,052")
        MSCBWrite("^FH\^FD" + "Registration with the Ministry of Agriculture SIF/DIPOA no. " + AllTrim(ZZ7->ZZ7_MSIF) + "^FS")
        MSCBWrite("^FO" + "135,052")
        MSCBWrite("^FH\^FD" + "Frigor\A1fico Silva Ind\A3stria e Com\82rcio LTDA." + "^FS")
        MSCBWrite("^FO" + "110,052")
        MSCBWrite("^FH\^FD" + "Abatedouro Frigor\A1fico Ind. e Com. de Carnes e seus derivados, BR 392 km 8 Tomazetti, Santa Maria - RS - Brasil, CEP 97065-400, CNPJ: 88.728.027/0001-46" + "^FS")
        MSCBWrite("^FO" + "085,052")
        MSCBWrite("^FH\^FD" + "Ind\A3stria Brasileira / Product of Brazil" + "^FS")

        MSCBWrite("^PQ" + _cQtdEtq + ",0,1,N")
        MSCBWrite("^XZ")

    Else
        //INFORMAÇÕES NO RODAPÉ DA ETIQUETA
        MSCBWrite("^CFA,19")
        MSCBWrite("^FO" + "110,100")
        MSCBWrite("^FH\^FD" + "Registro no Minist\82rio da Agricultura SIF/DIPOA sob n.\A7 " + AllTrim(ZZ7->ZZ7_MSIF) + "^FS")
        MSCBWrite("^FO" + "080,052")
        MSCBWrite("^FH\^FD" + "Frigor\A1fico Silva Ind\A3stria e Com\82rcio LTDA. Abatedouro Frigor\A1fico Ind. e Com. de Carnes e seus derivados" + "^FS")
        MSCBWrite("^FO" + "050,052")
        MSCBWrite("^FH\^FD" + "BR 392 km 8 Tomazetti, Santa Maria - RS - Brasil, CEP 97065-400, CNPJ: 88.728.027/0001-46" + "^FS")
        MSCBWrite("^FO" + "020,052")
        MSCBWrite("^FH\^FD" + "INDUSTRIA BRASILEIRA / PRODUCT OF BRAZIL" + "^FS")

        MSCBWrite("^CFA,20")
        MSCBWrite("^FO" + "575,052" + "^FH\^FD" + ZZ7->ZZ7_DESC + "^FS")
        MSCBWrite("^FO" + "545,052" + "^FH\^FD" + ZZ7->ZZ7_DESCI + "^FS")
        MSCBWrite("^FO" + "515,052" + "^FH\^FD" + ZZ7->ZZ7_CORTE + "^FS")
        MSCBWrite("^FO" + "485,052" + "^FH\^FD" + ZZ7->ZZ7_CORTEI + "^FS")

        MSCBWrite("^CFA,19")
        MSCBWrite("^FO" + "460,052" + "^FH\^FD DATA DE ABATE: ^FS")
        MSCBWrite("^FO" + "430,052" + "^FH\^FD SLAUGHTER DATE: ^FS")
        MSCBWrite("^FO" + "400,052" + "^FH\^FD DATA DE PRODU\80\C7O: ^FS")
        MSCBWrite("^FO" + "370,052" + "^FH\^FD PRODUCTION DATE: ^FS")
        MSCBWrite("^FO" + "340,052" + "^FH\^FD DATA DE VALIDADE: ^FS")
        MSCBWrite("^FO" + "310,052" + "^FH\^FD EXPIRY DATE: ^FS")

        MSCBWrite("^CFA,21^FO" + "460,350" + "^FH\^FD" + _DtaAbt + "^FS")
        MSCBWrite("^CFA,21^FO" + "430,350" + "^FH\^FD" + _DtAbtI + "^FS")
        MSCBWrite("^CFA,21^FO" + "400,350" + "^FH\^FD" + _DtaPro + "^FS")
        MSCBWrite("^CFA,21^FO" + "370,350" + "^FH\^FD" + _DtaProI + "^FS")
        MSCBWrite("^CFA,21^FO" + "340,350" + "^FH\^FD" + _DtVal + "^FS")
        MSCBWrite("^CFA,21^FO" + "310,350" + "^FH\^FD" + _DtValI + "^FS")
        MSCBWrite("^CFA,26^FO" + "280,075" + "^FH\^FD" + "LOTE/LOT: " + "D"+ _DtaProx + "P" + xTGet1 + "0" + xTGet5 + "^FS")
        MSCBWrite("^CFA,190^FO" + "340,830" + "^FH\^FD" + "0" + xTGet5 + "^FS")
        MSCBWrite("^CFA,21^FO" + "250,052" + "^FH\^FD" + "N\C7O CONT\90M GL\E9TEN/GLUTEN FREE" + "^FS")
        If ("CELSIUS" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELSIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Elseif ("CELCIUS" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELCIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Elseif ("CELSI" $ _MsgTem)
            _MsgTem := StrTran(Alltrim(SB1->B1_MENETQ2), "GRAUS CELCIUS", "\A7C" )
            //_MsgTem := StrTran(Alltrim(_MsgTem), "ºC", "\A7C")
        Endif    
        MSCBWrite("^CFA,21^FO" + "220,052" + "^FH\^FD" + SUBSTR(_MsgTem,1,29) + "^FS")
        MSCBWrite("^CFA,21^FO" + "190,052" + "^FH\^FD" + "KEEP FROZEN AT -18 \A7C" + "^FS")
        MSCBWrite("^CFA,19")

        //CODIGO DE BARRA
        MSCBWrite("^BY3,3,50")
        MSCBWrite("^FT135,170")
        MSCBWrite("^BCR,,N,N")
        MSCBWrite("^FD>;" + ZZ7->ZZ7_CODPRO + "^FS")
        //IMAGEM LOGO SIF
        MSCBWrite("^FO" + "130,460")
        MSCBWrite("^IME:LOGOSIF.GRF,1,1^FS")

        MSCBWrite("^PQ" + _cQtdEtq + ",0,1,N")
        MSCBWrite("^XZ")
    Endif
Return

