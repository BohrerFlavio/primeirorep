#INCLUDE "rwmake.ch"
#INCLUDE "protheus.ch"
#INCLUDE "topconn.ch"
#INCLUDE "TBICONN.ch"
#INCLUDE "TBICODE.ch"

USER FUNCTION DTI172()
    _sPl 	:= Chr(13) + Chr(10)
    _cCmdZPL := ""
    _codProd         := '999999'
    _dtaProd         := Date()
    _dtaLote         := Date()
    _pesoBruto       := '7.370'
    _pesoLiqui       := '7.370'
    _pesoTara       := '7.370'
    _aMatriz         := STRTOKARR(DToC(_dtaProd - 3),"/")
    _rastreabilidade := GETMV("MV_NUMIF") + _aMatriz[1] + _aMatriz[2] + _aMatriz[3] + "0000"
    _caixa           := '0008073241'
    _horario         := '11:23'
    _codBarra        := '7898292630066'
    _TipoEmba        := POSICIONE( 'ZZ7' ,1,FWXfilial( 'ZZ7' )+alltrim(_codProd), 'ZZ7_TPEMBA' )
    _sifDIPOA        := POSICIONE( 'ZZ7' ,1,FWXfilial( 'ZZ7' )+alltrim(_codProd), 'ZZ7_MSIF' )
    _mensagemSIF     := POSICIONE( 'SB1' ,1,FWXfilial( 'SB1' )+alltrim(_codProd), 'B1_MENETQ1' )
    
	dbselectarea('ZAM')
	ZAM->(DbSetOrder(2))
	IF ZAM->(dbSeek(xFilial('ZAM') + alltrim(getComputerName())))
	    _cIp := alltrim(ZAM->ZAM_IP)
	ENDIF 
    
    MSCBPRINTER('S600',"IP",,,,,_cIp)

    CodificZPL()

    MSCBWrite(_cCmdZPL)
    MSCBEND()
    MSCBCLOSEPRINTER()
RETURN

STATIC FUNCTION CodificZPL()
    
    _cCmdZPL += "" + _sPl
    _cCmdZPL += "^XA" + _sPl    
    _cCmdZPL += "^PW831" + _sPl
    //*********************************************************//
    //                                                         //
    //                  VALORES FIXOS                          //
    //                                                         //
    //*********************************************************//
    //TITULO DO CODIGO DO PRODUTO
    _cCmdZPL += "^FO0,1376^GFA,03584,03584,00016,:Z64:" + _sPl
    _cCmdZPL += ":53D9" + _sPl
    //TITULO DO NOME DO PRODUTO
    _cCmdZPL += "^FO96,1184^GFA,01664,01664,00004,:Z64:" + _sPl
    _cCmdZPL += ":8B45" + _sPl
    //TITULO DA ESPECIFICAÇÃO
    _cCmdZPL += "^FO192,1120^GFA,03840,03840,00008,:Z64:" + _sPl
    _cCmdZPL += ":61A6" + _sPl
    //CIDADE ESTADO PAIS
    _cCmdZPL += "^FO384,1152^GFA,07168,07168,00016,:Z64:" + _sPl
    _cCmdZPL += ":C42D" + _sPl
    _cCmdZPL += "^FO288,1184^GFA,06656,06656,00016,:Z64:" + _sPl
    _cCmdZPL += ":C694" + _sPl
    //TITULO E VALOR DO ESTABELECIMENTO
    _cCmdZPL += "^FO480,1376^GFA,03584,03584,00016,:Z64:" + _sPl
    _cCmdZPL += ":DB41" + _sPl
    _cCmdZPL += "^FO480,1280^GFA,00768,00768,00008,:Z64:" + _sPl
    _cCmdZPL += "eJxjYBgFcMD4AUI9/gOmmb/zgWk2OTYwzSfDDKZ5eHDQDBCajwGinp0Bop+5wQZiboPBoLafB0rzQWneBqj4AShdAKVloDQ/RAEP8weo/noozY9iHjpNLuD//x+FZoa6D0YzQt3JAKMfQOkE3GYCAMq+GK8=:0151" + _sPl
    //TITULO DA RASTREABILIDADE
    _cCmdZPL += "^FO576,1408^GFA,03072,03072,00016,:Z64:" + _sPl
    _cCmdZPL += ":A18C" + _sPl
    //TITULO DO REGISTRO NO MINISTERIO
    IF(_sifDIPOA = '0303/1733')
        _cCmdZPL += "^FO672,1152^GFA,05376,05376,00012,:Z64:" + _sPl
        _cCmdZPL += ":1B72" + _sPl
    ELSEIF(_sifDIPOA = '0304/1733')
        _cCmdZPL += "^FO672,1152^GFA,05376,05376,00012,:Z64:" + _sPl
        _cCmdZPL += ":0B3C" + _sPl
    ENDIF
    //IMAGEM DO RELOGIO
    _cCmdZPL += "^FO736,1184^GFA,00512,00512,00008,:Z64:" + _sPl
    _cCmdZPL += "eJxjYBi+QGsBhD4gAKaYGiBcFqi0BhOEFoDyFaC0E5RugtINqDQjVAczVAeQ7wA2HqqCkSEYYp3CKph6FADnN+CgHaC0Epq7NBhQ3csFdT8zzMAFUNr+A4RmggngAQAhjgsS:3C04" + _sPl
    //TITULO DA DATA DE PRODUÇÃO
    _cCmdZPL += "^FO0,832^GFA,03584,03584,00016,:Z64:" + _sPl
    _cCmdZPL += ":A57C" + _sPl
    //TITULO DO LOTE
    _cCmdZPL += "^FO96,960^GFA,01536,01536,00016,:Z64:" + _sPl
    _cCmdZPL += ":3D46" + _sPl
    //TITULO DA DATA DE VALIDADE
    _cCmdZPL += "^FO192,832^GFA,03584,03584,00016,:Z64:" + _sPl
    _cCmdZPL += ":6BED" + _sPl
    //CONTEÚDO DA DATA DE VALIDADE
    _cCmdZPL += "^FO192,672^GFA,02048,02048,00016,:Z64:" + _sPl
    _cCmdZPL += ":2FDE" + _sPl
    //TITULO DO PESO BRUTO
    _cCmdZPL += "^FO288,896^GFA,01920,01920,00012,:Z64:" + _sPl
    _cCmdZPL += ":8215" + _sPl
    //TITULO DO PESO LIQUIDO
    _cCmdZPL += "^FO384,896^GFA,01920,01920,00012,:Z64:" + _sPl
    _cCmdZPL += ":09CD" + _sPl
    //TIITULO TARA DA CAIXA
    _cCmdZPL += "^FO480,928^GFA,01536,01536,00012,:Z64:" + _sPl
    _cCmdZPL += ":863F" + _sPl
    //TITULO DA TEMPERATURA
    _cCmdZPL += "^FO576,672^GFA,04608,04608,00012,:Z64:" + _sPl
    _cCmdZPL += ":1807" + _sPl
    //CONTEÚDO DA TEMPERATURA
    _cCmdZPL += "^FO576,608^GFA,03072,03072,00016,:Z64:" + _sPl
    _cCmdZPL += ":1242" + _sPl
    //DESTINO
    _cCmdZPL += "^FO672,640^GFA,04992,04992,00012,:Z64:" + _sPl
    _cCmdZPL += ":8694" + _sPl
    //LOGO SIF
    _cCmdZPL += "^FO0,0^GFA,32640,32640,00060,:Z64:"  + _sPl 
    _cCmdZPL += ""
    _cCmdZPL += ""
    _cCmdZPL += ""
    _cCmdZPL += ":6671" + _sPl    
    //INFO DE REGISTRO NA CHINA
    _cCmdZPL += "^FO448,32^GFA,06528,06528,00012,:Z64:" + _sPl
    _cCmdZPL += ":D7C3" + _sPl
    //ENDEREÇO DO FRIGORIFICO
    _cCmdZPL += "^FO608,0^GFA,13056,13056,00024,:Z64:"  + _sPl    
    _cCmdZPL += ""
    _cCmdZPL += ":7587"  + _sPl
    //LOGO DO FRIGORIFICO
    _cCmdZPL += "^FO512,64^GFA,07168,07168,00016,:Z64:" + _sPl
    _cCmdZPL += ":E37A"  + _sPl
    //**********************************************************//
    //                                                          //
    //                  VALORES VARIAVEIS                       //
    //                                                          //
    //**********************************************************//
    //VALOR DO CODIGO DO PRODUTO
    _cCmdZPL += "^FT43,1375^A0B,28,28^FH\^FD" + _codProd + "^FS" + _sPl
    //VALOR DA RASTREABILIDADE
    _cCmdZPL += "^FT632,1375^A0B,28,28^FH\^FD" + _rastreabilidade + "^FS" + _sPl
    //VALOR DO CODIGO DE BARRAS
    _cCmdZPL += "^BY3,3,55^FT806,1566^BCB,,Y,N" + _sPl
    _cCmdZPL += "^FD>;" + _codBarra + "^FS" + _sPl
    //VALOR DO HORARIO
    _cCmdZPL += "^FT786,1207^A0B,28,28^FH\^FD" + _horario + "^FS" + _sPl
    //VALOR DA DATA DE PRODUÇÃO
    _cCmdZPL += "^FT41,783^A0B,28,28^FH\^FD" + DToC(_dtaProd) + "^FS" + _sPl
    //VALOR DO LOTE
    _cCmdZPL += "^FT136,783^A0B,28,28^FH\^FD" + DToC(_dtaLote) + "^FS" + _sPl
    //VALOR DO PESO BRUTO
    _cCmdZPL += "^FT321,783^A0B,28,28^FH\^FD" + _pesoBruto + 'Kg ' + "^FS" + _sPl
    //VALOR DO PESO LIQUIDO
    _cCmdZPL += "^FT416,783^A0B,28,28^FH\^FD" + _pesoLiqui + 'Kg ' + "^FS" + _sPl
    //VALOR DA TARA
    _cCmdZPL += "^FT511,783^A0B,28,28^FH\^FD" + _pesoTara + 'Kg ' + "^FS" + _sPl
    //VALOR DA DESCRIÇÃO DO PRODUTO
    IF(_sifDIPOA = '0303/1733')
        _cCmdZPL += "^FO128,1152^GFA,03584,03584,00008,:Z64:" + _sPl
        _cCmdZPL += ":32E0" + _sPl
    ELSEIF(_sifDIPOA = '0304/1733')
        _cCmdZPL += "^FO128,1216^GFA,03072,03072,00008,:Z64:" + _sPl
        _cCmdZPL += ":562B" + _sPl
    ENDIF
    //VALOR DOS TIPOS DE EMBALAGEM
    IF (_TipoEmba = 'VP' .or. _TipoEmba = 'vp' .or. _TipoEmba = 'VACUO' .or. _TipoEmba = 'vacuo' .or. _TipoEmba = 'VÁCUO' .or. _TipoEmba = 'vácuo')
        _cCmdZPL += "^FO256,1344^GFA,02048,02048,00008,:Z64:" + _sPl
        _cCmdZPL += ":C3E7" + _sPl
    ELSEIF (_TipoEmba = 'IWP' .or. _TipoEmba = 'iwp')
        _cCmdZPL += "^FO256,1344^GFA,02048,02048,00008,:Z64:" + _sPl
        _cCmdZPL += ":445F" + _sPl
    ELSEIF (_TipoEmba = 'BLOCO' .or. _TipoEmba = 'Bloco' )
        _cCmdZPL += "^FO256,1248^GFA,02816,02816,00008,:Z64:" + _sPl
        _cCmdZPL += ":9233" + _sPl
    ENDIF
    //VALOR NOME DO PRODUTO
    IF (alltrim(SB1->B1_DESCRED) $ 'CARNE')//SE CARNE
        _cCmdZPL += "^FO224,1280^GFA,02560,02560,00008,:Z64:" + _sPl
        _cCmdZPL += ":BC1B" + _sPl
    ELSEIF (alltrim(SB1->B1_DESCRED) $ 'COSTELA')//SE COSTELA
        _cCmdZPL += "^FO224,1344^GFA,02048,02048,00008,:Z64:" + _sPl
        _cCmdZPL += ":186C" + _sPl
    ELSEIF (alltrim(SB1->B1_DESCRED) $ 'GORDURA' .and. _TipoEmba = 'BLOCO' .or. _TipoEmba = 'Bloco')//SE GORDURA BLOCO
        _cCmdZPL += "^FO224,1280^GFA,02560,02560,00008,:Z64:" + _sPl
        _cCmdZPL += ":336B" + _sPl
    ELSEIF (alltrim(SB1->B1_DESCRED) $ 'GORDURA' .and. _TipoEmba = 'VP' .or. _TipoEmba = 'vp' .or. _TipoEmba = 'VACUO' .or. _TipoEmba = 'vacuo' .or. _TipoEmba = 'VÁCUO' .or. _TipoEmba = 'vácuo')//SE GORDURA VACUO
        _cCmdZPL += "^FO224,1088^GFA,04096,04096,00008,:Z64:" + _sPl
        _cCmdZPL += ":A6D3" + _sPl
    ELSEIF (alltrim(SB1->B1_DESCRED) $ 'RECORTE')//SE RECORTE 
        _cCmdZPL += "^FO224,1248^GFA,02816,02816,00008,:Z64:" + _sPl
        _cCmdZPL += ":B862" + _sPl
    ENDIF
    
    _cCmdZPL += "^PQ1,0,1,Y^XZ"
RETURN
