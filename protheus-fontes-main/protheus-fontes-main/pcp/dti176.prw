USER FUNCTION DTI176()
	LOCAL cAlias := 'SZE'
	LOCAL usuario := RetCodUsr()
	LOCAL grpusr := GETMV('SI_USRSZE')
	PRIVATE cCadastro := 'Itens de Ordem de Recebimento'

	IF(usuario $ grpusr)
		Private aRotina := { {"Pesquisar"   ,"AxPesqui"       ,0,1} ,;
		{"&Visualizar" ,"AxVisual"       ,0,2},; 	
		{"Alterar"    	,"AxAltera"  	  ,0,4}}	
	ELSE
		Private aRotina := {{"&Visualizar" ,"AxVisual"       ,0,2}}
	ENDIF
	
	dbSelectArea(cAlias)
	dbSetOrder(1)
	
	mBrowse(6, 1, 22, 75, cAlias)
RETURN
