#INCLUDE "PROTHEUS.CH"
#INCLUDE "RWMAKE.CH"
#INCLUDE "TOTVS.CH"

USER FUNCTION DWLEDI()
    LOCAL cPath       := 'M:\NeoGridClient\'
    LOCAL cAplication := 'ngclient.bat'
    
    IF EXISTDIR(cPath)
        IF FILE(cPath+cAplication)
            ShellExecute("OPEN", cAplication, "", cPath, 1)
        ELSE
            MSGSTOP("O arquivo " + cAplication + " nใo existe", "ERRO" )
            RETURN
        ENDIF
    ELSE
        MSGSTOP("O diret๓rio CLIENTE MERCADOR nใo existe ou nใo estแ mapeado na unidade 'M:\'", "ERRO" )
        RETURN
    ENDIF
RETURN .T.
