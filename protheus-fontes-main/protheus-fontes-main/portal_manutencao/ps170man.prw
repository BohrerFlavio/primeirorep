User Function PS170MAN()
	Local cHtml:= ""
	Local cBody:= ""

	cBody:= "Legenda<br><br>"
	cBody+= "<img src=imagens/verde.png>1 - Aberto (Solicitante)<br>"
	cBody+= "<img src=imagens/amarelo.png>2 - Sob analise (Manutencao)<br>"
	cBody+= "<img src=imagens/amarelo.png>3 - Iniciado (Manutencao)<br>"
	cBody+= "<img src=imagens/azul.png>4 - Finalizado (Manutencao)<br>"
	cBody+= "<img src=imagens/vermelho.png>5 - Finalizado (Solicitante)<br>"
	cBody+= "<img src=imagens/roxo.png>1 - Reativado (Solicitante)<br>"

	oAlert:= PSWebAlert():New("ps170man_alert", cBody, HTTPSESSION->cLogo)
	cHtml:= oAlert:show()

Return cHtml
