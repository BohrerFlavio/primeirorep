//Substituir no menu MDTA695
User function OB_MDT695

    IF getmv('MV_NG2ESOC')=='2'
        MDTA695()
    else
        Aviso("Atenção!","Neste momento esta com a integração ao TAF habilitado (MV_NG2ESOC), pois estao fazendo uma CAT, favor aguarde alguns minutos e tente novamente")
        If MsgYesNo("Mesmo assim deseja entrar nesta rotina?", "Atenção!")
            PUTMV('MV_NG2ESOC','2')
            MDTA695()
            
        endif
    endif
    

Return
  
