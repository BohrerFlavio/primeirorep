#INCLUDE "rwmake.ch"
#INCLUDE "protheus.ch"
#INCLUDE "topconn.ch"
#INCLUDE "TBICONN.ch"
#INCLUDE "TBICODE.ch"

USER FUNCTION DTI171()
    //COMUNICAÇÃO COM A IMPRESSORA
	dbselectarea('ZAM')
	ZAM->(DbSetOrder(2))
	IF ZAM->(dbSeek(xFilial('ZAM') + alltrim(getComputerName())))
	    _cIp := alltrim(ZAM->ZAM_IP)
	ENDIF 

    codProd         := '999999'
    dtaProd         := Date()
    aMatriz := STRTOKARR(DToC(dtaProd - 3),"/")
    //rastreabilidade := GETMV("MV_NUMIF") + (DToC(dtaProd - 3)) + "0000"                          //'17330710190000'
    //rastreabilidade := GETMV("MV_NUMIF") + STRTOKARR(DToC(dtaProd - 3),"/")  + "0000" 
    rastreabilidade := GETMV("MV_NUMIF") +  aMatriz[1] + aMatriz[2] + aMatriz[3] + "0000"//'17330710190000'
    sifDIPOA        := POSICIONE( 'ZZ7' ,1,FWXfilial( 'ZZ7' )+alltrim(codProd), 'ZZ7_MSIF' )   //CARNE = 0304/1733 | GORDURA = 0304/1733
    mensagemSIF     := POSICIONE( 'SB1' ,1,FWXfilial( 'SB1' )+alltrim(codProd), 'B1_MENETQ1' )
    TipoEmba        := POSICIONE( 'ZZ7' ,1,FWXfilial( 'ZZ7' )+alltrim(codProd), 'ZZ7_TPEMBA' ) //VP ou IWP ou Bloco// 

    MSCBPRINTER('S600',"IP",,,,,_cIp)

    //CODIFICAÇÃO EM ZPL
    Private _sPl 	:= Chr(13) + Chr(10)
    _cCmdZPL := ""
    _cCmdZPL += "" + _sPl
    _cCmdZPL += "^XA" + _sPl    
    _cCmdZPL += "^PW831" + _sPl
    //CODIGO DO PRODUTO
    _cCmdZPL += "^FO0,0^GFA,01920,01920,00020,:Z64:"  + _sPl
    _cCmdZPL += ":5F4A"  + _sPl
    //NOME DO PRODUTO
    IF(sifDIPOA = '0303/1733')
        //CARNE CONGELADA DE BOVINO SEM OSSO
        _cCmdZPL += "^FO128,0^GFA,04224,04224,00044,:Z64:"  + _sPl
        _cCmdZPL += ":AF39"  + _sPl
        IF (TipoEmba = 'VP')
            //ESPECIFICAÇÃO
            _cCmdZPL += "^FO128,64^GFA,01536,01536,00016,:Z64:" + _sPl
            _cCmdZPL += ":82ED" + _sPl
        ELSEIF (TipoEmba = 'IWP')
            //ESPECIFICAÇÃO            
            _cCmdZPL += "^FO128,64^GFA,01152,01152,00012,:Z64:"  + _sPl
            _cCmdZPL += ":E478"  + _sPl
        ELSEIF (TipoEmba = 'Bloco' .or. 'BLOCO')
        ENDIF
    ELSEIF(sifDIPOA = '0304/1733')
        //GORDURA DE BOVINO CONGELADA
        _cCmdZPL += "^FO128,0^GFA,03456,03456,00036,:Z64:" + _sPl
        _cCmdZPL += ":8CAD" + _sPl
        //ESPECIFICAÇÃO        
        _cCmdZPL += "^FO128,64^GFA,01920,01920,00020,:Z64:" + _sPl
        _cCmdZPL += ":4A89" + _sPl
    ENDIF
    //ESPECIFICAÇÃO
    _cCmdZPL += "^FO0,64^GFA,01920,01920,00020,:Z64:" + _sPl
    _cCmdZPL += ":DE5E" + _sPl        
    //_cCmdZPL += "" + _sPl
    IF (TipoEmba = 'VP')
        _cCmdZPL += "^FO0,128^GFA,01280,01280,00020,:Z64:"  + _sPl
        _cCmdZPL += ":3892"  + _sPl
    ELSEIF (TipoEmba = 'IWP')
        _cCmdZPL += "^FO0,128^GFA,01280,01280,00020,:Z64:"  + _sPl
        _cCmdZPL += "eJzt0LFqwzAQgGGBQFmMsx64oFe4EAjtpFfxIyhTMmTPotDVeYtk7nLFLyEwweoT1F2KoCbOCbeQrVM7+Z/Ex4mDE2Jq6teg/HnJMrTUzNRVZeQJBBCbDW1o9mpQptuytT3b4qNaH59d7ZaIlDzZuVocD+6VbRNLfPy2NVvtTPfpCb8iW/Gi36qLH7IlrrxBSHuLQtfg/RWSSZSjgWQjMN0mShzS3rlm20YCKToyOE9zec5mbTIkDE+n0VQy/oUesxjujed6zLS9v4EU7073u4d/O/rU33cDzCRbHQ==:D4F6"  + _sPl
    ELSEIF (TipoEmba = 'Bloco' .or. TipoEmba = TipoEmba = 'BLOCO')
        _cCmdZPL += "^FO0,128^GFA,01792,01792,00028,:Z64:"  + _sPl
        _cCmdZPL += ":D15E"  + _sPl
    ENDIF
    //LOTE
    _cCmdZPL += "^FO0,160^GFA,01152,01152,00012,:Z64:"  + _sPl
    _cCmdZPL += "eJxjYBjigPkPAweDAZT9j0ECzmZDZsvbyZm3Qdn2++ztj0H1Gs4otjgA1cs+I8EAymaWR2JbIrGB6mHsf/bz7A1g5sidk4Oy6QmYGRgEkNgG2Nk2NRawcGCoq6mBs5/DXczMcNjgHw72AQaE+mcw9p86G7g5f2xkLOC2DRC42fC/AcE+iI3N/LPhfyOMc3MDAyOMff/x/wcw9T8bEmBM5psINm7zNzDCzbyPYDP+/MBPhi9GIgAAyxlLLg==:0D73"  + _sPl
    _cCmdZPL+= "^FT131,217^A0N,17,16^FH\^FD" + DToC(dtaProd - 3) + "^FS" + _sPl
    //DATA DE PRODUÇÃO
    _cCmdZPL += "^FO224,224^GFA,01920,01920,00020,:Z64:"  + _sPl
    _cCmdZPL += ":B0DA"  + _sPl
    _cCmdZPL+= "^FT386,275^A0N,17,16^FH\^FD" + DToC(dtaProd) + "^FS" + _sPl
    //DATA DE VALIDADE
    _cCmdZPL += "^FO0,224^GFA,01536,01536,00016,:Z64:"  + _sPl
    _cCmdZPL += ":16B8"  + _sPl
    _cCmdZPL += "^FO128,224^GFA,01152,01152,00012,:Z64:"  + _sPl
    _cCmdZPL += ":8BAC"  + _sPl
    //RASTREABILIDADE
    _cCmdZPL += "^FO224,160^GFA,01920,01920,00020,:Z64:"  + _sPl
    _cCmdZPL += ":4BAD"  + _sPl
    //_cCmdZPL += "^FO352,160^GFA,01024,01024,00016,:Z64:"  + _sPl
    //_cCmdZPL += "eJztzjEKwzAQRNGFhanM1i7E4sq1K5FKOcyAL6BC5V49UpSEHCEB/+5VMyJXfxXCHUhwTz0RiwizYvcoPREH6daMbD2RvKhmp1PZE9kXs71bbRqrGTIzPlYdNv3yyTO9fSMRjJUvH7UiWmx17uEoBSh43inDKY2/kebfq5/qASjvJWA=:A5DF"  + _sPl
    _cCmdZPL += "^FT361,201^A0N,17,16^FH\^FD" + rastreabilidade + "^FS"  + _sPl
    //TEMPERATURA DE ESTOCAGEM
    _cCmdZPL += "^FO0,288^GFA,03072,03072,00032,:Z64:"  + _sPl
    _cCmdZPL += ":EBBB"  + _sPl
    _cCmdZPL += "^FO224,288^GFA,01024,01024,00016,:Z64:"  + _sPl
    _cCmdZPL += ":7737"  + _sPl
    //CIDADE/UF/PAIS
    _cCmdZPL += "^FO0,352^GFA,03840,03840,00060,:Z64:"  + _sPl
    _cCmdZPL += ":68A7"  + _sPl
    //DESTINO
    _cCmdZPL += "^FO0,384^GFA,04608,04608,00048,:Z64:"  + _sPl
    _cCmdZPL += ":B854"  + _sPl
    //Nº DE REGISTRO DA CHINA
    _cCmdZPL += "^FO256,480^GFA,00896,00896,00028,:Z64:"  + _sPl
    _cCmdZPL += "eJxjYKAJYPzwn/+DDD9788EHHyps5KAMiBz7j//9P2Tk+48//vjjT509lAGRY5M52CNjZnnnXbn13HPPi3dCGBA5Po6DPTxmBjdyzKR52w4nboAwIHI8DCB9uOT+8/9IxinX/wCn3IEzBfXY5fg4Dpyx+L8BqxybzIEzEgd3YvUD0O89MgfnY/U7MMx4+BvOYw2zUTBMAQAuy4D/:187C"  + _sPl
    _cCmdZPL += "^FO0,448^GFA,03072,03072,00032,:Z64:"  + _sPl
    _cCmdZPL += ":6FE0"  + _sPl
    //REGISTRO NO MINISTÉRIO    
    _cCmdZPL += "^FT20,543^A0N,17,16^FH\^FD" + mensagemSIF + "^FS  + _sPl

    _cCmdZPL += "^PQ1,0,1,Y^XZ"

    MSCBWrite(_cCmdZPL)
    MSCBEND()
    MSCBCLOSEPRINTER()
RETURN
