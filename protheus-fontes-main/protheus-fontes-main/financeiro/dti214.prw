USER FUNCTION DTI214()

	LOCAL cAlias := 'SZT'
	PRIVATE cCadastro := 'Pesagem de caminh๕es'	
	PRIVATE aRotina := {{"Visualizar","AxVisual",0, 2},;
						{"Alterar"   ,"AxAltera",0,4}}

	dbSelectArea(cAlias)
	dbSetOrder(1)

	mBrowse(6, 1, 22, 75, cAlias)

RETURN
//Fun็ใo para validar os usuแrios com permissใo de alterar campos da tabela SZT
USER FUNCTION DTI214a()
	lRet := IF(LogUserName() $ GetMV('SI_ALTSZT'),.T.,.F.)
RETURN lRet
