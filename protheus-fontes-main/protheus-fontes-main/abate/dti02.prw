User Function dti02()

	cPerg := "DTI02"

	if !pergunte(cPerg,.t.)
		return
	endif                 

	//se estiver um habilita o parametro
	if mv_par01 = 1

		putmv('SI_ALTDENT',.T.)

	else//senใo desabilita

		putmv('SI_ALTDENT',.F.)

	endif                    

return
